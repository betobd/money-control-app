{
  "expo": {
    "name": "MoneyControlApp",
    "slug": "MoneyControlApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "moneycontrolapp",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "android": {
      "package": "com.alber.moneycontrolapp",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#060E1E"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Money Control to use device biometrics for app unlock."
        }
      ],
      "expo-build-properties",
      "react-native-quick-crypto",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "18311772-b735-4d0b-beda-f5a79b64a7dc"
      }
    }
  }
}
